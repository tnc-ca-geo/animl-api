{
  "extends": "@tsconfig/node22/tsconfig.json", // https://github.com/tsconfig/bases?tab=readme-ov-file#node-22-tsconfigjson
  "compilerOptions": {
    "strict": true,
    "preserveConstEnums": true,
    "sourceMap": true,
    "allowJs": true,
    "outDir": "./.build",
    "experimentalDecorators": true
  },
  "include": ["./src/**/*"]
}
